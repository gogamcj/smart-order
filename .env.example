# ─────────────────────────────────────────────────────────────────────────────
# API 서버 환경변수 예시. 실제 값은 절대 커밋하지 마세요. 복사: cp .env.example .env
# [2단계 사용] 표시가 없는 항목은 이후 단계에서 쓰는 자리표시자입니다.
# REPLACE_WITH_ 로 시작하는 값은 서버가 '설정 안 됨'으로 취급합니다.
# 화면(프런트) 빌드 변수는 apps/*/.env.example 에 따로 있으며, 공개되어도 되는 값만 넣습니다.
# ─────────────────────────────────────────────────────────────────────────────

# [2단계 사용] 배포 환경: local | staging | production  (DB 의 deployment_info 와 일치해야 결제가 저장됨)
APP_ENV=local
# [2단계 사용] API 포트
PORT=3000
# [2단계 사용] 리버스 프록시(Caddy 등) 뒤에서 실행하면 true (클라이언트 IP 기록·속도 제한용)
TRUST_PROXY=false

# ── 데이터베이스 ────────────────────────────────────────────────────────────
# [1단계 사용] 마이그레이션 실행 계정(테이블 소유자). API 서버에서는 사용하지 않음
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/qr_order
# [2단계 사용] API 일반 요청용 (qr_app 역할 멤버 계정)
DATABASE_URL=postgres://qr_api_login:CHANGE_ME@localhost:5432/qr_order
# [2단계 사용] 결제 확정·로그인·최고 관리자용 (qr_system 역할 멤버 계정)
DATABASE_SYSTEM_URL=postgres://qr_worker_login:CHANGE_ME@localhost:5432/qr_order
# [1단계 사용] 테스트가 임시 DB 를 만들 때 쓰는 관리자 연결 (로컬·CI 전용)
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 오리진 / 쿠키 [2단계 사용] ─────────────────────────────────────────────
# 화면과 API 는 같은 등록 도메인 아래에 있어야 로그인 쿠키가 동작합니다(docs/06-deployment.md)
API_PUBLIC_URL=http://localhost:3000
# 경로 분리 배포면 경로까지 (예: https://www.example.kr/order)
ORDER_WEB_ORIGIN=http://localhost:5173
# path | hash  (Cafe24 에서 .htaccess 가 동작하지 않으면 hash. 고객 앱 VITE_ROUTER 와 같게)
ORDER_WEB_ROUTING=path
MERCHANT_WEB_ORIGIN=http://localhost:5174
ADMIN_WEB_ORIGIN=http://localhost:5175
# QR 에 인쇄되는 주소를 직접 정할 때만 ({token} 자리에 토큰). 비우면 ORDER_WEB_ORIGIN + 라우팅 방식으로 만듦
ORDER_QR_URL_TEMPLATE=
# 비우면 local 은 false, 그 외는 true. production 에서 false 로 두면 서버가 시작하지 않음
COOKIE_SECURE=
# 세션·주문 컨텍스트 쿠키 서명용 무작위 32바이트 이상 (openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
# 정산 계좌번호·전화번호 암호화 키 (base64 32바이트, openssl rand -base64 32). 운영은 비밀 저장소 사용
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# 전화번호 조회용 HMAC 키 (base64 32바이트)
DATA_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
# 개발용 고객 로그인(카카오 없이). APP_ENV=local 에서만 동작, production 에서 true 면 서버가 시작하지 않음
DEV_LOGIN_ENABLED=false

# ── 카카오 로그인 (developers.kakao.com) [2단계 사용] ─────────────────────────
# 세 값이 모두 있어야 카카오 로그인이 켜집니다. 없으면 로그인 화면에 '설정되지 않음' 안내
KAKAO_REST_API_KEY=REPLACE_WITH_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=REPLACE_WITH_KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# ── 결제 [2단계 사용] ──────────────────────────────────────────────────────
# 정산 모델 B(플랫폼 대표 가맹점). PG 미정이라 실제 PG 연동은 아직 없음
# disabled : 결제 요청 시 503 PAYMENT_NOT_CONFIGURED (가짜 성공 없음)
# fake     : 로컬 개발·자동화 테스트 전용 가짜 PG. 화면에 '테스트 결제'로 표시. production 에서는 서버·DB 가 거부
# portone | tosspayments : 3단계에서 구현 예정. 지금 고르면 서버가 시작하지 않음
PAYMENT_PROVIDER=disabled
PORTONE_STORE_ID=REPLACE_WITH_PORTONE_STORE_ID
PORTONE_API_SECRET=REPLACE_WITH_PORTONE_API_SECRET
PORTONE_WEBHOOK_SECRET=REPLACE_WITH_PORTONE_WEBHOOK_SECRET
# 업체별 가맹점(모델 A)이면 채널 키는 tenant_payment_accounts 에 업체별로 저장

# ── 카카오 알림톡 (공식 딜러사) ─────────────────────────────────────────────
# disabled 이면 발송하지 않고 notifications 에 skipped 로 기록
ALIMTALK_PROVIDER=disabled
ALIMTALK_API_BASE_URL=REPLACE_WITH_PROVIDER_API_URL
ALIMTALK_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
ALIMTALK_SENDER_PROFILE_KEY=REPLACE_WITH_SENDER_PROFILE_KEY
SMS_FALLBACK_SENDER_NUMBER=REPLACE_WITH_REGISTERED_NUMBER

# ── 이미지 저장 [2단계 사용] ────────────────────────────────────────────────
# local 만 구현됨 (s3 는 아직 미구현, 고르면 서버가 시작하지 않음)
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=var/media
# 이미지 공개 주소. 비우면 ${API_PUBLIC_URL}/media
MEDIA_PUBLIC_BASE_URL=

# ── 객체 스토리지 (미구현, 자리표시자) ─────────────────────────────────────
S3_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
S3_REGION=ap-northeast-2
S3_PUBLIC_BUCKET=REPLACE_WITH_PUBLIC_BUCKET
S3_PRIVATE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
CDN_BASE_URL=REPLACE_WITH_CDN_URL

# ── 모니터링 ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
