{
  "name": "@qr/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/src/main.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts up",
    "db:status": "tsx --env-file-if-exists=../../.env src/db/cli.ts status",
    "db:types": "kysely-codegen --dialect postgres --url \"$DATABASE_MIGRATION_URL\" --out-file src/db/schema.ts --exclude-pattern schema_migrations --date-parser string",
    "admin:create": "tsx --env-file-if-exists=../../.env src/scripts/create-platform-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:roles": "tsx --env-file-if-exists=../../.env src/scripts/create-login-roles.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "kysely": "0.29.7",
    "pdfkit": "0.20.2",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.4"
  }
}
