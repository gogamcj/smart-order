# 고객 주문 웹(공개 번들). 여기에는 공개되어도 되는 값만 둔다. 비밀 키 금지.
VITE_API_BASE_URL=http://localhost:3000
# browser | hash  (Cafe24 에서 .htaccess 가 동작하지 않으면 hash, 서버 ORDER_WEB_ROUTING 과 같게)
VITE_ROUTER=browser
# 서브도메인이 아니라 경로로 올릴 때 (예: /order/)
VITE_BASE_PATH=/
# 로컬 개발에서만 true. 운영 빌드에서는 개발용 로그인 버튼을 숨긴다(서버도 운영에서는 거부)
VITE_DEV_LOGIN=false
