{
  "name": "qr-order-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-Tenant QR Table Order Platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "pnpm --filter @qr/api db:migrate",
    "db:status": "pnpm --filter @qr/api db:status",
    "db:roles": "pnpm --filter @qr/api db:roles",
    "admin:create": "pnpm --filter @qr/api admin:create",
    "dev:api": "pnpm --filter @qr/api dev",
    "dev:order": "pnpm --filter @qr/order dev",
    "dev:merchant": "pnpm --filter @qr/merchant dev",
    "dev:admin": "pnpm --filter @qr/admin dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0"
    }
  }
}
